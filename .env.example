# ============================================================
# ScribeAI Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ----- Database (required) ----------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/scribeai"

# ----- Auth (required) --------------------------------------
# Secret for signing JWT / session cookies (min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ----- Google Gemini AI (optional) --------------------------
# Get your key at https://aistudio.google.com/apikey
# If not set, the app falls back to mock AI responses
GEMINI_API_KEY="your_gemini_api_key_here"

# ----- Google Cloud Speech-to-Text (optional) ---------------
# Required only for real (non-simulated) speech recognition
# https://cloud.google.com/speech-to-text/docs/quickstart-client-libraries
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"

# ----- App URLs ---------------------------------------------
# URL the Next.js frontend is served from (used by the server for CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# URL the Socket.IO / Express server listens on (used by the frontend)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ----- Server port (optional, defaults to 3001) -------------
PORT=3001

# ----- Node environment -------------------------------------
NODE_ENV="development"
